# Hostinger production environment
NODE_ENV=production
PORT=3000

# Deploy under https://azurotech.in/ftainvoicepro
NEXT_PUBLIC_BASE_PATH=/ftainvoicepro

# Use an absolute path on the server for persistent SQLite data.
# Example directory: /home/USERNAME/apps/ftainvoicepro/data
DATABASE_URL="file:/home/USERNAME/apps/ftainvoicepro/data/prod.db"

# Optional public API URL if you use it in future client code
NEXT_PUBLIC_API_URL="https://azurotech.in/ftainvoicepro/api"

NEXTAUTH_URL="https://azurotech.in/ftainvoicepro"
NEXTAUTH_SECRET="change-this-to-a-long-random-secret"

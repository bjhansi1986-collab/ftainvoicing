# Render production environment
NODE_ENV=production
PORT=3000

# Render typically serves app from root path
NEXT_PUBLIC_BASE_PATH=

# Use Render Persistent Disk mount path for SQLite
DATABASE_URL="file:/var/data/prod.db"

# Optional public API URL if you use it in future client code
NEXT_PUBLIC_API_URL="https://your-render-service.onrender.com/api"

NEXTAUTH_URL="https://your-render-service.onrender.com"
NEXTAUTH_SECRET="change-this-to-a-long-random-secret"
